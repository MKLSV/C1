# Claude API (обязательно для работы бота)
ANTHROPIC_API_KEY=sk-ant-...

# Модель для диалога (рекомендация: Opus 4.8 — качество; Sonnet 4.6 — эконом)
CLAUDE_MODEL=claude-opus-4-8

# Supabase (опционально на MVP — без них используется in-memory хранилище сессий)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
